{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", "tooling/src/eslint/**"],
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "lint": { "dependsOn": ["transit"] },
    "typecheck": { "dependsOn": ["transit"] },
    "test:unit": { "dependsOn": ["transit"] },
    "test:integration": { "dependsOn": ["transit"], "passThroughEnv": ["TESTCONTAINERS_*"] },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
